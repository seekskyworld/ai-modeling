# ai-modeling configuration template. No credentials belong in this file.
# The application DOES NOT automatically load .env.
# Load explicitly with Node 24+, for example from the built project directory:
# node --env-file=.env dist/cli/main.js --help
# node --env-file=.env dist/cli/main.js mcp --toolset studio
# Existing process environment variables take precedence. Shell variables are not expanded.
# Use only AI_MODELING_* project settings; previous project prefixes are not aliases.

AI_MODELING_PROFILE=default

# Optional state/cache directory. Use an absolute path you choose.
# AI_MODELING_DATA_DIR=/absolute/path/to/ai-modeling-data

# Optional download root restriction; not the CLI's default --out directory.
# AI_MODELING_OUTPUT_DIR=/absolute/path/to/output

# Optional input roots: colon-separated on macOS/Linux, semicolon-separated on Windows.
# AI_MODELING_INPUT_ROOTS=/absolute/path/to/images:/absolute/path/to/models

# Optional HTTP proxy. Replace the sample port with your own proxy endpoint.
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1,::1

# Optional browser executable; must be an absolute path to Chrome or Edge.
# AI_MODELING_BROWSER_EXECUTABLE=/absolute/path/to/chrome-or-edge

# Optional, explicitly authorized existing local CDP endpoint; remote hosts are rejected.
# AI_MODELING_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222

# Optional local rendering/conversion programs.
# AI_MODELING_BLENDER=/absolute/path/to/blender
# AI_MODELING_FFMPEG=/absolute/path/to/ffmpeg

# Optional experimental full-toolset mesh editing. Leave disabled unless needed.
# AI_MODELING_EXPERIMENTAL_MESH_EDIT=1
