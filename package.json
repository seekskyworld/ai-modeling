{
  "name": "@seekskyworld/ai-modeling",
  "version": "0.1.9",
  "description": "ai-modeling: CLI execution, MCP tools and Agent Skill guidance for Tripo Studio",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ai-modeling": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "README.md",
    "README.zh-CN.md",
    "assets/branding",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "docs",
    "skills/ai-modeling",
    "examples",
    ".env.example"
  ],
  "scripts": {
    "build": "node scripts/clean-build.ts && tsc -p tsconfig.build.json && node scripts/copy-assets.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint cli mcp studio tests scripts version.ts",
    "test": "node scripts/run-tests.ts",
    "check": "npm run version:check && npm run workflow:check && npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm test && npm run build",
    "start": "node dist/cli/main.js mcp --toolset studio",
    "format": "prettier --write cli mcp studio tests scripts version.ts",
    "format:check": "prettier --check cli mcp studio tests scripts version.ts",
    "docs:check": "node scripts/check-docs.ts",
    "package:check": "node scripts/check-package.ts",
    "export": "node scripts/export.ts",
    "export:skill": "node scripts/export.ts --target skill",
    "export:mcp": "node scripts/export.ts --target mcp",
    "version:check": "node scripts/check-version.ts",
    "workflow:check": "node scripts/check-workflows.ts",
    "package:smoke": "node scripts/package-smoke.ts",
    "package:consumer-smoke": "node scripts/package-consumer-smoke.ts",
    "package:registry-check": "node scripts/registry-check.ts",
    "release:check": "node scripts/release.ts check",
    "release:prepare": "node scripts/release.ts prepare",
    "capabilities": "node scripts/capabilities.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@google/model-viewer": "4.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@msgpack/msgpack": "3.1.3",
    "commander": "15.1.0",
    "gl-matrix": "3.4.4",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.65.1",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "undici": "8.12.4",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode": "1.5.6",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "license": "Apache-2.0",
  "keywords": [
    "3d",
    "tripo",
    "cli",
    "mcp",
    "studio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seekskyworld/ai-modeling.git"
  },
  "homepage": "https://github.com/seekskyworld/ai-modeling#readme",
  "bugs": {
    "url": "https://github.com/seekskyworld/ai-modeling/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
